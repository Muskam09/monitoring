# ─── Database ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=devops_dashboard
# When running via docker-compose, host "db" is used by the backend container
DATABASE_URL=postgresql+psycopg://postgres:change_me_in_real_env@db:5432/devops_dashboard

# ─── Backend / JWT ─────────────────────────────────────
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=please_generate_a_strong_random_value_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Agent ─────────────────────────────────────────────
# Static token the Go agent uses to authenticate to the backend
AGENT_API_TOKEN=replace-me-with-a-random-token

# ─── Google OAuth (Task 6) ─────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Task 2 — Google reCAPTCHA v2 ──────────────────────
# Register at https://www.google.com/recaptcha/admin/create (type: v2 "I'm not a robot")
# Leave BOTH blank to disable the captcha (useful for offline lab defence).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Task 3 / Task 7 — mail delivery (SMTP → MailHog) ──
# docker-compose includes a `mailhog` service; keep these defaults for the lab.
SMTP_HOST=mailhog
SMTP_PORT=1025
# Leave SMTP_USER / SMTP_PASSWORD empty for MailHog (no auth).
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=DevOps Dashboard <no-reply@dashboard.local>
# Base URL the backend puts in email links — the frontend should serve the
# /activate/{token} and /reset-password/{token} routes.
APP_BASE_URL=http://localhost:5173

# ─── Task 4 — brute-force policy ───────────────────────
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ─── Token lifetimes ───────────────────────────────────
ACTIVATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ─── Task 5 — 2FA (TOTP) ───────────────────────────────
# "Issuer" the user will see in Google Authenticator / Authy
TOTP_ISSUER=DevOps Dashboard

# ─── Frontend (Vite, prefix VITE_ required) ────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_RECAPTCHA_SITE_KEY=
VITE_API_BASE_URL=http://localhost:8000
